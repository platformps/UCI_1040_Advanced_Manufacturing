<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GLAB 637.1.1: Technical Walkthrough Presentation</title>
  <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --header-bg: #1a2332;
      --accent-color: #2563eb;
      --accent-hover: #1d4ed8;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border-color: #334155;
      --badge-bg: rgba(37, 99, 235, 0.2);
      --badge-border: rgba(96, 165, 250, 0.3);
      --badge-text: #60a5fa;
      --success-color: #10b981;
      --warning-color: #f59e0b;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }

    .presentation-container {
      background-color: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      width: 100%;
      max-width: 960px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .header {
      padding: 24px 30px 18px 30px;
      border-bottom: 1px solid var(--border-color);
      background-color: var(--header-bg);
    }

    .header h1 {
      font-size: 1.35rem;
      color: var(--text-main);
      margin-top: 4px;
      line-height: 1.3;
    }

    .header .subtitle {
      font-size: 0.8rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 700;
    }

    .progress-container {
      width: 100%;
      height: 6px;
      background-color: var(--border-color);
      position: relative;
    }

    .progress-bar {
      height: 100%;
      background-color: var(--accent-color);
      width: 20%;
      transition: width 0.3s ease;
    }

    .slide-body {
      padding: 28px 30px;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .phase-badge {
      display: inline-block;
      background-color: var(--badge-bg);
      color: var(--badge-text);
      border: 1px solid var(--badge-border);
      padding: 4px 12px;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      align-self: flex-start;
    }

    .slide-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-main);
      line-height: 1.25;
    }

    .content-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 24px;
      align-items: center;
    }

    @media (max-width: 768px) {
      .content-grid {
        grid-template-columns: 1fr;
      }
    }

    .overview-text {
      font-size: 0.92rem;
      line-height: 1.6;
      color: #cbd5e1;
    }

    .overview-text p {
      margin-bottom: 12px;
    }

    .overview-text ul {
      margin-left: 20px;
    }

    .overview-text li {
      margin-bottom: 8px;
    }

    .image-card {
      background-color: #0b1120;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 280px;
      text-align: center;
    }

    .svg-graphic {
      width: 100%;
      max-height: 220px;
      border-radius: 6px;
    }

    .image-caption {
      margin-top: 12px;
      font-size: 0.78rem;
      color: var(--text-muted);
      font-style: italic;
      line-height: 1.4;
    }

    .footer {
      padding: 18px 30px;
      border-top: 1px solid var(--border-color);
      background-color: var(--header-bg);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .slide-counter {
      font-size: 0.85rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    .nav-buttons {
      display: flex;
      gap: 12px;
    }

    .btn {
      background-color: var(--accent-color);
      color: white;
      border: none;
      padding: 10px 18px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
      transition: background-color 0.2s ease;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .btn:hover:not(:disabled) {
      background-color: var(--accent-hover);
    }

    .btn:disabled {
      background-color: var(--border-color);
      color: var(--text-muted);
      cursor: not-allowed;
      opacity: 0.6;
    }
  </style>
</head>
<body>

  <div class="presentation-container">
    <div class="header">
      <div class="subtitle">Guided Lab High-Level Technical Walkthrough</div>
      <h1>GLAB 637.1.1: Electrical Safety, Live-Dead-Live DMM Verification, &amp; Ohm's/Watt's Law</h1>
    </div>

    <div class="progress-container">
      <div class="progress-bar" id="progress-bar"></div>
    </div>

    <div class="slide-body">
      <div class="phase-badge" id="phase-badge">Phase 1 of 5</div>
      <h2 class="slide-title" id="slide-title">Slide Title</h2>
      
      <div class="content-grid">
        <div class="overview-text" id="overview-text">
          <!-- Rendered via JS -->
        </div>

        <div class="image-card" id="image-card">
          <!-- SVG Illustration rendered via JS -->
        </div>
      </div>
    </div>

    <div class="footer">
      <div class="slide-counter" id="slide-counter">Slide 1 of 5</div>
      <div class="nav-buttons">
        <button class="btn" id="prev-btn" disabled>&#9668; Previous Phase</button>
        <button class="btn" id="next-btn">Next Phase &#9658;</button>
      </div>
    </div>
  </div>

  <script>
    const slideData = [
      {
        phase: "Phase 1 of 5: Pre-Lab Tech Onboarding",
        title: "VR Simulation & Baseline PPE Orientation",
        overview: `<p>Before touching live hardware, technicians complete virtual multimeter orientation and don baseline safety gear in classroom UID 508:</p>
                   <ul>
                     <li><strong>VR Simulation (Zone 2 Grid):</strong> Retrieve Meta Quest 3 VR headset from charging flightcase and launch Interplay ELEC113 (<em>How to Use a Multimeter</em>).</li>
                     <li><strong>Virtual Lead Check:</strong> Inspect virtual DMM test leads for insulation cracks, select DC Voltage (V DC), and execute virtual Live-Dead-Live voltage checks on a 24V DC terminal strip.</li>
                     <li><strong>Classroom Safety Baseline:</strong> Return VR gear and don TICONN ANSI Z87.1 safety glasses and Schwer ANSI A5 cut-resistant gloves at Zone 1 Learner Desks.</li>
                   </ul>`,
        svg: `<svg class="svg-graphic" viewBox="0 0 320 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="320" height="200" rx="8" fill="#1e293b"/>
                <path d="M40 70 C40 50, 120 50, 120 70 L120 110 C120 130, 40 130, 40 110 Z" fill="#334155" stroke="#60a5fa" stroke-width="3"/>
                <circle cx="65" cy="90" r="14" fill="#0f172a" stroke="#2563eb" stroke-width="2"/>
                <circle cx="95" cy="90" r="14" fill="#0f172a" stroke="#2563eb" stroke-width="2"/>
                <rect x="150" y="45" width="130" height="120" rx="6" fill="#0f172a" stroke="#334155" stroke-width="2"/>
                <rect x="165" y="60" width="100" height="30" rx="3" fill="#0284c7"/>
                <text x="215" y="80" fill="#ffffff" font-size="14" font-weight="bold" text-anchor="middle">24.0 VDC</text>
                <circle cx="185" cy="125" r="8" fill="#ef4444"/>
                <circle cx="215" cy="125" r="8" fill="#10b981"/>
                <circle cx="245" cy="125" r="8" fill="#3b82f6"/>
                <path d="M 60 130 Q 110 180 185 133" stroke="#ef4444" stroke-width="3" fill="none" stroke-dasharray="4 2"/>
                <path d="M 100 130 Q 150 180 215 133" stroke="#64748b" stroke-width="3" fill="none" stroke-dasharray="4 2"/>
                <text x="160" y="185" fill="#94a3b8" font-size="11" font-weight="bold">Interplay ELEC113 VR Diagnostic</text>
              </svg>`,
        caption: "Technical Visual 1: Meta Quest 3 VR Simulation & Digital Multimeter Diagnostic Interface"
      },
      {
        phase: "Phase 2 of 5: Zero-Energy Isolation",
        title: "LOTO Application & 3-Step Live-Dead-Live (LDL) DMM Check",
        overview: `<p>Establish a verified zero-energy state prior to opening panel enclosures or touching electrical terminal blocks:</p>
                   <ul>
                     <li><strong>Safety Gate PPE:</strong> Don Class 0 1,000V rated electrical rubber insulated gloves with goat-leather protectors outside Zone 4 Arc Flash Boundary.</li>
                     <li><strong>Physical LOTO Lockout:</strong> Open BEMATE-200 main switch POWER_SW and breaker CB-1, attach TRADESAFE scissor hasp with a personal red padlock through Hole #1, and affix an OSHA Danger Tag with a firm tug-test.</li>
                     <li><strong>3-Point LDL Verification:</strong> Set Fluke 117 DMM to V DC:
                       <br>&bull; <em>Phase A (Live Pre-Test)</em>: Probe known live 24V DC Aux output (+23.8V to +24.2V DC).
                       <br>&bull; <em>Phase B (Dead Check)</em>: Probe isolated TB-1 (+24V) to TB-2 (0V GND); verify 0.0V DC.
                       <br>&bull;  process C (Live Post-Test)</em>: Re-probe known live 24V DC Aux output (+23.8V to +24.2V DC).
                     </li>
                   </ul>`,
        svg: `<svg class="svg-graphic" viewBox="0 0 320 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="320" height="200" rx="8" fill="#1e293b"/>
                <rect x="30" y="40" width="100" height="120" rx="6" fill="#0f172a" stroke="#dc2626" stroke-width="3"/>
                <rect x="50" y="55" width="60" height="25" fill="#f59e0b" rx="2"/>
                <text x="80" y="72" fill="#000000" font-size="10" font-weight="900" text-anchor="middle">DANGER</text>
                <circle cx="80" cy="110" r="16" fill="#dc2626"/>
                <rect x="74" y="100" width="12" height="20" fill="#f8fafc" rx="2"/>
                <path d="M150 50 L290 50 L290 150 L150 150 Z" fill="#0f172a" stroke="#334155" stroke-width="2"/>
                <text x="220" y="75" fill="#10b981" font-size="12" font-weight="bold" text-anchor="middle">1. LIVE: 24.0V DC</text>
                <text x="220" y="105" fill="#60a5fa" font-size="12" font-weight="bold" text-anchor="middle">2. DEAD: 0.0V DC</text>
                <text x="220" y="135" fill="#10b981" font-size="12" font-weight="bold" text-anchor="middle">3. LIVE: 24.0V DC</text>
                <text x="160" y="180" fill="#94a3b8" font-size="11" font-weight="bold">3-Step Live-Dead-Live Protocol</text>
              </svg>`,
        caption: "Technical Visual 2: TRADESAFE LOTO Scissor Hasp Lockout & 3-Step LDL Meter Test Procedure"
      },
      {
        phase: "Phase 3 of 5: Mathematical Calculation Sprint",
        title: "Single-Variable Ohm's Law (V=I×R) & Watt's Law (P=V×I) Calculations",
        overview: `<p>Calculate theoretical circuit parameters using single-variable algebraic substitution at Zone 1 Learner Desks:</p>
                   <ul>
                     <li><strong>Ohm's Law (I = V / R):</strong> Substitute constant 24.0V DC supply voltage across load resistors (R1 = 120.0 Ω; R2 = 240.0 Ω) to calculate expected branch currents (I1 = 0.20 A / 200 mA; I2 = 0.10 A / 100 mA).</li>
                     <li><strong>Watt's Law (P = V × I):</strong> Calculate power dissipation for load R1 (P1 = 24.0V × 0.20A = 4.80 Watts) and load R2 (P2 = 24.0V × 0.10A = 2.40 Watts).</li>
                     <li><strong>Thermal Power Sizing:</strong> Determine that standard 1/4 W or 2 W carbon film resistors will thermally overload, requiring minimum 5.0 W metal oxide power resistors.</li>
                   </ul>`,
        svg: `<svg class="svg-graphic" viewBox="0 0 320 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="320" height="200" rx="8" fill="#1e293b"/>
                <circle cx="100" cy="100" r="60" fill="#0f172a" stroke="#2563eb" stroke-width="3"/>
                <line x1="40" y1="100" x2="160" y2="100" stroke="#2563eb" stroke-width="2"/>
                <line x1="100" y1="100" x2="100" y2="160" stroke="#2563eb" stroke-width="2"/>
                <text x="100" y="85" fill="#f8fafc" font-size="22" font-weight="bold" text-anchor="middle">V</text>
                <text x="70" y="135" fill="#f8fafc" font-size="20" font-weight="bold" text-anchor="middle">I</text>
                <text x="130" y="135" fill="#f8fafc" font-size="20" font-weight="bold" text-anchor="middle">R</text>
                <rect x="180" y="45" width="125" height="110" rx="6" fill="#0f172a" stroke="#334155" stroke-width="2"/>
                <text x="190" y="70" fill="#60a5fa" font-size="11" font-weight="bold">R1 = 120.0 Ω</text>
                <text x="190" y="90" fill="#cbd5e1" font-size="11">I1 = 0.20 A</text>
                <text x="190" y="110" fill="#ef4444" font-size="11" font-weight="bold">P1 = 4.80 W</text>
                <text x="190" y="130" fill="#f59e0b" font-size="10" font-weight="bold">Req: 5W Rating</text>
                <text x="160" y="180" fill="#94a3b8" font-size="11" font-weight="bold">Ohm's & Watt's Law Algebraic Wheel</text>
              </svg>`,
        caption: "Technical Visual 3: Ohm's & Watt's Law Formulas & Thermal Power Dissipation Calculations"
      },
      {
        phase: "Phase 4 of 5: Benchtop Circuit Execution",
        title: "Physical Circuit Wiring & Fluke 117 DMM Measurements",
        overview: `<p>Construct 24V DC load circuits on the BEMATE-200 benchtop trainer in Zone 3 and audit physical readings against calculations:</p>
                   <ul>
                     <li><strong>De-Energized Resistance Test:</strong> Set Fluke 117 DMM to Ω auto-range and measure disconnected Resistor R2 (240.0 Ω ± 5% tolerance, expecting 235.0 Ω to 245.0 Ω).</li>
                     <li><strong>Energized Parallel Voltage Drop:</strong> Connect banana jumpers from +24V DC to TB-1 and 0V GND across R2; energize trainer and measure parallel voltage drop (VR2 = 24.0V DC).</li>
                     <li><strong>Energized In-Series Current Test:</strong> De-energize, break circuit path between +24V and TB-1, move Fluke 117 red lead to 10A Current Jack, select A DC, insert DMM IN-SERIES with the load path, energize and measure line current (0.100 A / 100 mA ± 5%).</li>
                   </ul>`,
        svg: `<svg class="svg-graphic" viewBox="0 0 320 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="320" height="200" rx="8" fill="#1e293b"/>
                <rect x="20" y="30" width="280" height="140" rx="8" fill="#0f172a" stroke="#334155" stroke-width="2"/>
                <circle cx="50" cy="60" r="10" fill="#ef4444"/>
                <text x="50" y="64" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle">+24V</text>
                <circle cx="50" cy="140" r="10" fill="#3b82f6"/>
                <text x="50" y="144" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle">GND</text>
                <rect x="110" y="45" width="70" height="110" rx="6" fill="#f59e0b" stroke="#d97706" stroke-width="2"/>
                <rect x="120" y="55" width="50" height="25" fill="#0f172a"/>
                <text x="145" y="72" fill="#10b981" font-size="11" font-weight="bold" text-anchor="middle">100 mA</text>
                <rect x="220" y="80" width="50" height="20" fill="#334155" stroke="#94a3b8"/>
                <text x="245" y="94" fill="#ffffff" font-size="10" font-weight="bold" text-anchor="middle">240 Ω</text>
                <path d="M60 60 L110 60" stroke="#ef4444" stroke-width="3"/>
                <path d="M180 60 L245 60 L245 80" stroke="#ef4444" stroke-width="3"/>
                <path d="M245 100 L245 140 L60 140" stroke="#3b82f6" stroke-width="3"/>
                <text x="160" y="185" fill="#94a3b8" font-size="11" font-weight="bold">In-Series Ammeter Current Circuit Configuration</text>
              </svg>`,
        caption: "Technical Visual 4: Fluke 117 DMM In-Series Circuit Wiring for Ammeter Measurement"
      },
      {
        phase: "Phase 5 of 5: AI Maintenance Log Audit",
        title: "AI Maintenance Log Verification & GDP Shift Handover",
        overview: `<p>Audit an AI-generated draft report for Work Order WO-2026-ELEC-6371-01 against physical DMM measurements and NFPA 70E safety rules:</p>
                   <ul>
                     <li><strong>Error 1 (Power Calculation):</strong> AI calculated 0.20 W for a 1/4 W resistor. Correct to actual P = 4.80 W (requires 5 W power resistor to prevent fire hazard).</li>
                     <li><strong>Error 2 (LOTO Omission):</strong> AI skipped LOTO on 24V DC. Correct to mandate full zero-energy LOTO and 3-point Live-Dead-Live verification.</li>
                     <li><strong>Error 3 (Parallel Ammeter):</strong> AI placed ammeter in parallel. Correct to mandate IN-SERIES current wiring to prevent short circuits and blown DMM fuses.</li>
                     <li><strong>GDP Documentation:</strong> Record corrected technician findings in pen, date/initial single-line strike-through corrections, and complete peer sign-off.</li>
                   </ul>`,
        svg: `<svg class="svg-graphic" viewBox="0 0 320 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="320" height="200" rx="8" fill="#1e293b"/>
                <rect x="25" y="30" width="270" height="140" rx="6" fill="#0f172a" stroke="#334155" stroke-width="2"/>
                <text x="40" y="55" fill="#ef4444" font-size="11" font-weight="bold">AI LOG ERROR DETECTED:</text>
                <text x="40" y="75" fill="#cbd5e1" font-size="10">&bull; Power: 0.20W vs Actual 4.80W (Fire Risk)</text>
                <text x="40" y="93" fill="#cbd5e1" font-size="10">&bull; LOTO Skipped on 24V DC (Safety Hazard)</text>
                <text x="40" y="111" fill="#cbd5e1" font-size="10">&bull; Ammeter in Parallel (Direct Short Circuit)</text>
                <line x1="35" y1="125" x2="285" y2="125" stroke="#334155" stroke-width="1"/>
                <text x="40" y="145" fill="#10b981" font-size="11" font-weight="bold">&#10004; HUMAN VERIFICATION OVERRIDE PASSED</text>
                <text x="40" y="160" fill="#94a3b8" font-size="9">Signed: Technician &amp; Peer Inspector (GDP Compliant)</text>
                <text x="160" y="185" fill="#94a3b8" font-size="11" font-weight="bold">AI Maintenance Log Audit &amp; GDP Verification</text>
              </svg>`,
        caption: "Technical Visual 5: AI Log Technical Error Audit & GDP Human Verification Override"
      }
    ];

    let currentSlide = 0;

    const progressBar = document.getElementById('progress-bar');
    const phaseBadge = document.getElementById('phase-badge');
    const slideTitle = document.getElementById('slide-title');
    const overviewText = document.getElementById('overview-text');
    const imageCard = document.getElementById('image-card');
    const slideCounter = document.getElementById('slide-counter');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');

    function updateSlide() {
      const data = slideData[currentSlide];
      
      // Update Progress Bar
      const progressPercent = ((currentSlide + 1) / slideData.length) * 100;
      progressBar.style.width = `${progressPercent}%`;

      // Update Text Content
      phaseBadge.textContent = data.phase;
      slideTitle.textContent = data.title;
      overviewText.innerHTML = data.overview;
      
      // Update SVG Container
      imageCard.innerHTML = `
        ${data.svg}
        <div class="image-caption">${data.caption}</div>
      `;

      // Update Footer Elements
      slideCounter.textContent = `Slide ${currentSlide + 1} of ${slideData.length}`;

      // Update Buttons
      prevBtn.disabled = currentSlide === 0;
      nextBtn.disabled = currentSlide === slideData.length - 1;
    }

    prevBtn.addEventListener('click', () => {
      if (currentSlide > 0) {
        currentSlide--;
        updateSlide();
      }
    });

    nextBtn.addEventListener('click', () => {
      if (currentSlide < slideData.length - 1) {
        currentSlide++;
        updateSlide();
      }
    });

    // Keyboard Arrow Navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' && currentSlide > 0) {
        currentSlide--;
        updateSlide();
      } else if (e.key === 'ArrowRight' && currentSlide < slideData.length - 1) {
        currentSlide++;
        updateSlide();
      }
    });

    // Initial Render
    updateSlide();
  </script>
</body>
</html>