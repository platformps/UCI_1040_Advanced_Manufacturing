<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GLAB 635.1.1 Walkthrough - Industrial Piping Metallurgy & Compatibility</title>
    <style>
        :root {
            --ps-blue: #005587;
            --ps-orange: #F26D21;
            --ps-dark: #1E293B;
            --ps-light: #F8FAFC;
            --ps-card: #FFFFFF;
            --ps-border: #E2E8F0;
            --text-muted: #64748B;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--ps-light);
            color: var(--ps-dark);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        #app-container {
            background-color: var(--ps-card);
            width: 100%;
            max-width: 820px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
            border: 1px solid var(--ps-border);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .header {
            background-color: var(--ps-blue);
            color: #ffffff;
            padding: 24px;
            text-align: center;
            border-bottom: 4px solid var(--ps-orange);
        }

        .header h1 {
            font-size: 1.4rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
        }

        .header p {
            font-size: 0.88rem;
            opacity: 0.9;
        }

        .progress-container {
            width: 100%;
            background-color: #E2E8F0;
            height: 8px;
        }

        .progress-bar {
            height: 100%;
            background-color: var(--ps-orange);
            width: 20%;
            transition: width 0.4s ease;
        }

        .content-area {
            padding: 30px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 420px;
        }

        .phase-badge {
            background-color: #E0F2FE;
            color: var(--ps-blue);
            font-size: 0.78rem;
            font-weight: 700;
            padding: 4px 14px;
            border-radius: 20px;
            text-transform: uppercase;
            margin-bottom: 12px;
            border: 1px solid #BAE6FD;
        }

        .phase-title {
            color: var(--ps-blue);
            font-size: 1.3rem;
            font-weight: 700;
            margin-bottom: 18px;
            text-align: center;
        }

        .schematic-box {
            width: 100%;
            min-height: 210px;
            background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
            border-radius: 10px;
            border: 1px solid #334155;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px;
            margin-bottom: 22px;
            color: #38BDF8;
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.3);
            text-align: center;
        }

        .schematic-title {
            color: #F8FAFC;
            font-size: 0.95rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            margin-top: 10px;
            text-transform: uppercase;
        }

        .schematic-caption {
            color: #94A3B8;
            font-size: 0.82rem;
            margin-top: 4px;
        }

        .phase-text {
            font-size: 0.98rem;
            line-height: 1.65;
            color: #334155;
            width: 100%;
            text-align: left;
        }

        .phase-text p {
            margin-bottom: 10px;
        }

        .phase-text ul {
            padding-left: 20px;
        }

        .phase-text li {
            margin-bottom: 8px;
        }

        .controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 30px;
            background-color: #F8FAFC;
            border-top: 1px solid var(--ps-border);
        }

        .btn {
            background-color: var(--ps-blue);
            color: white;
            border: none;
            padding: 10px 24px;
            font-size: 0.92rem;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .btn:hover:not(:disabled) {
            background-color: #003D63;
        }

        .btn:disabled {
            background-color: #CBD5E1;
            cursor: not-allowed;
            color: #94A3B8;
        }

        .step-count {
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--text-muted);
        }
    </style>
</head>
<body>

    <div id="app-container">
        <div class="header">
            <h1>GLAB 635.1.1 Industrial Piping Metallurgy & Compatibility</h1>
            <p>Student Pre-Lab High-Level Walkthrough</p>
        </div>
        
        <div class="progress-container">
            <div class="progress-bar" id="progress-bar"></div>
        </div>

        <div class="content-area">
            <span class="phase-badge" id="phase-badge">Phase 1 of 5</span>
            <h2 class="phase-title" id="phase-title">Loading...</h2>
            
            <div class="schematic-box" id="schematic-container">
            </div>

            <div class="phase-text" id="phase-text">
            </div>
        </div>

        <div class="controls">
            <button class="btn" id="btn-prev" onclick="changePhase(-1)" disabled>Previous</button>
            <span class="step-count" id="step-count">1 / 5</span>
            <button class="btn" id="btn-next" onclick="changePhase(1)">Next</button>
        </div>
    </div>

    <script>
        const phases = new Array();
        phases.push({
            badge: "Phase 1 of 5",
            title: "Pre-Lab VR Onboarding & Safety Briefing",
            svgGraphic: '<svg width="180" height="90" viewBox="0 0 180 90" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="10" y="20" width="70" height="50" rx="8" stroke="#38BDF8" stroke-width="2" fill="#1E293B"/><path d="M25 45 C25 35, 45 35, 45 45 C45 35, 65 35, 65 45" stroke="#F26D21" stroke-width="3" fill="none"/><circle cx="35" cy="48" r="4" fill="#38BDF8"/><circle cx="55" cy="48" r="4" fill="#38BDF8"/><rect x="100" y="20" width="70" height="50" rx="8" stroke="#38BDF8" stroke-width="2" fill="#1E293B"/><path d="M115 35 L155 35 M115 45 L155 45 M115 55 L140 55" stroke="#38BDF8" stroke-width="2.5" stroke-linecap="round"/><circle cx="150" cy="55" r="4" fill="#F26D21"/></svg>',
            schematicTitle: "System Schematic 1: VR Grid & PPE Safety Setup",
            schematicCaption: "Zone 2 Virtual Reality Simulation & Zone 1/3 Safety Gear Preparation",
            text: "<p>Learners execute digital onboarding and safety compliance prior to hardware testing:</p><ul><li><strong>Zone 2 VR Grid Simulation:</strong> Access Meta Quest 3 headsets in Zone 2 to launch Interplay PLMB102, practicing visual differentiation of Schedule 40 vs Schedule 80 wall thicknesses in a 3D facility.</li><li><strong>PPE Safety Compliance:</strong> Assemble at Zone 1 desks donning ANSI Z87.1 clear safety glasses and Schwer ANSI A5 cut-resistant gloves before touching physical pipe spools.</li></ul>"
        });
        phases.push({
            badge: "Phase 2 of 5",
            title: "Dimensional Audit & Wall Thickness Calculation",
            svgGraphic: '<svg width="180" height="90" viewBox="0 0 180 90" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="90" cy="45" r="36" stroke="#38BDF8" stroke-width="3" fill="none"/><circle cx="90" cy="45" r="24" stroke="#F26D21" stroke-width="3" fill="none"/><line x1="90" y1="9" x2="90" y2="21" stroke="#38BDF8" stroke-width="2"/><line x1="90" y1="69" x2="90" y2="81" stroke="#38BDF8" stroke-width="2"/><text x="90" y="49" fill="#F8FAFC" font-size="10" font-family="sans-serif" text-anchor="middle" font-weight="bold">t = (OD - ID) / 2</text></svg>',
            schematicTitle: "System Schematic 2: Pipe Cross-Section Sizing Formula",
            schematicCaption: "Digital Caliper Outer & Inner Diameter Measurement Diagram",
            text: "<p>Learners retrieve 1 inch Nominal Pipe Size inspection kits from Zone 3 cabinets:</p><ul><li><strong>Digital Caliper Measurements:</strong> Measure Outer Diameter (OD) and Inner Diameter (ID) in inches to three decimal places (0.000 in).</li><li><strong>Single-Variable Equation:</strong> Calculate wall thickness using t = (OD - ID) / 2.</li><li><strong>GDP Logging:</strong> Record values in Table 1.1 in pen, identifying Schedule 40 Carbon Steel (t=0.133 in), Schedule 80 Carbon Steel (t=0.179 in), Type L Copper (t=0.050 in), and CPVC spools.</li></ul>"
        });
        phases.push({
            badge: "Phase 3 of 5",
            title: "Process Fluid Evaluation & Chemical Compatibility Matrix",
            svgGraphic: '<svg width="180" height="90" viewBox="0 0 180 90" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="20" y="15" width="140" height="60" rx="6" stroke="#38BDF8" stroke-width="2" fill="#1E293B"/><line x1="20" y1="35" x2="160" y2="35" stroke="#334155" stroke-width="1.5"/><line x1="20" y1="55" x2="160" y2="55" stroke="#334155" stroke-width="1.5"/><line x1="70" y1="15" x2="70" y2="75" stroke="#334155" stroke-width="1.5"/><text x="45" y="29" fill="#94A3B8" font-size="9" font-family="sans-serif" text-anchor="middle">Fluid</text><text x="115" y="29" fill="#94A3B8" font-size="9" font-family="sans-serif" text-anchor="middle">Recommended</text><text x="45" y="49" fill="#F8FAFC" font-size="9" font-family="sans-serif" text-anchor="middle">30% NaOH</text><text x="115" y="49" fill="#4ADE80" font-size="9" font-family="sans-serif" text-anchor="middle" font-weight="bold">Sch 80 CPVC</text><text x="45" y="69" fill="#F8FAFC" font-size="9" font-family="sans-serif" text-anchor="middle">Hydraulic Oil</text><text x="115" y="69" fill="#38BDF8" font-size="9" font-family="sans-serif" text-anchor="middle" font-weight="bold">Sch 80 Steel</text></svg>',
            schematicTitle: "System Schematic 3: Industrial Chemical Resistance Grid",
            schematicCaption: "Process Fluid Compatibility Audit for Temperature & Pressure Limits",
            text: "<p>Learners evaluate industrial process conditions against published chemical compatibility matrices:</p><ul><li><strong>Fluid Domain Analysis:</strong> Cross-reference aggressive fluids (30% NaOH, 98% H2SO4, DI Water, Hydraulic Oil) against material suitability ratings.</li><li><strong>Operating Constraints:</strong> Assess temperature limits (150 deg F) and operating pressures (120 PSI).</li><li><strong>Material Selection:</strong> Complete Table 1.2 to verify Schedule 80 CPVC as the required material for hot caustic dosing lines.</li></ul>"
        });
        phases.push({
            badge: "Phase 4 of 5",
            title: "AI Compatibility Log Audit & Physical Override",
            svgGraphic: '<svg width="180" height="90" viewBox="0 0 180 90" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="15" y="20" width="60" height="50" rx="6" stroke="#EF4444" stroke-width="2" fill="#1E293B"/><text x="45" y="42" fill="#EF4444" font-size="9" font-family="sans-serif" text-anchor="middle" font-weight="bold">AI Draft</text><text x="45" y="55" fill="#94A3B8" font-size="8" font-family="sans-serif" text-anchor="middle">3 Errors</text><path d="M85 45 L105 45" stroke="#F26D21" stroke-width="3" stroke-linecap="round"/><polyline points="100,39 107,45 100,51" stroke="#F26D21" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/><rect x="115" y="20" width="50" height="50" rx="6" stroke="#4ADE80" stroke-width="2" fill="#1E293B"/><text x="140" y="42" fill="#4ADE80" font-size="9" font-family="sans-serif" text-anchor="middle" font-weight="bold">Human</text><text x="140" y="55" fill="#4ADE80" font-size="8" font-family="sans-serif" text-anchor="middle">Override</text></svg>',
            schematicTitle: "System Schematic 4: AI Draft Audit & Human Override Workflow",
            schematicCaption: "Physical Verification & Detection of Injected Engineering Errors",
            text: "<p>Learners audit an AI assistant draft recommendation for Work Order WO-2026-PIPE-01:</p><ul><li><strong>Error Identification:</strong> Detect three engineering errors: specifying copper for caustic soda, substituting Schedule 40 steel for high pressure, and assuming identical inner diameters.</li><li><strong>Human Verification Override:</strong> Utilize physical caliper data and fluid compatibility charts to correct all three errors under Good Documentation Practices.</li></ul>"
        });
        phases.push({
            badge: "Phase 5 of 5",
            title: "Quality & Zero-Leak Verification Sign-Off",
            svgGraphic: '<svg width="180" height="90" viewBox="0 0 180 90" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="30" y="15" width="120" height="60" rx="6" stroke="#4ADE80" stroke-width="2" fill="#1E293B"/><path d="M45 45 L55 55 L75 35" stroke="#4ADE80" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/><line x1="85" y1="38" x2="135" y2="38" stroke="#F8FAFC" stroke-width="2" stroke-linecap="round"/><line x1="85" y1="52" x2="135" y2="52" stroke="#38BDF8" stroke-width="2" stroke-linecap="round"/><text x="110" y="65" fill="#94A3B8" font-size="8" font-family="sans-serif" text-anchor="middle">Peer Verified</text></svg>',
            schematicTitle: "System Schematic 5: Quality Sign-Off & Workstation Clearance",
            schematicCaption: "Dual Signature Verification & Classroom Reset Protocol",
            text: "<p>The lab closes with formal Quality Assurance verification and workstation reset:</p><ul><li><strong>GDP Sign-Off:</strong> Complete primary technician and peer inspector signatures verifying physical measurements, single-variable calculations, and AI log audits.</li><li><strong>Station Reset:</strong> Return calipers and pipe kits to Zone 3 cabinets, ensure 3 to 4 foot service aisles remain clear, and upload completed logs to Canvas LMS under GLAB 635.1.1.</li></ul>"
        });

        let currentIndex = 0;

        function updateUI() {
            const current = phases.at(currentIndex);
            document.getElementById('phase-badge').textContent = current.badge;
            document.getElementById('phase-title').textContent = current.title;
            document.getElementById('phase-text').innerHTML = current.text;
            
            const schematicContainer = document.getElementById('schematic-container');
            schematicContainer.innerHTML = current.svgGraphic +
                '<div class="schematic-title">' + current.schematicTitle + '</div>' +
                '<div class="schematic-caption">' + current.schematicCaption + '</div>';

            const progress = ((currentIndex + 1) / phases.length) * 100;
            document.getElementById('progress-bar').style.width = progress + '%';
            document.getElementById('step-count').textContent = (currentIndex + 1) + ' / ' + phases.length;

            document.getElementById('btn-prev').disabled = currentIndex === 0;
            
            const btnNext = document.getElementById('btn-next');
            if (currentIndex === phases.length - 1) {
                btnNext.textContent = "Finish";
                btnNext.disabled = true;
            } else {
                btnNext.textContent = "Next";
                btnNext.disabled = false;
            }
        }

        function changePhase(step) {
            currentIndex += step;
            if (currentIndex < 0) currentIndex = 0;
            if (currentIndex >= phases.length) currentIndex = phases.length - 1;
            updateUI();
        }

        updateUI();
    </script>
</body>
</html>