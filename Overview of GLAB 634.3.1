<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GLAB 634.3.1: Precision Fastener Torquing & Tool Safety Audit Walkthrough</title>
    <style>
        :root {
            --ps-blue: #004b87;
            --ps-orange: #f26f29;
            --ps-dark: #1e293b;
            --ps-light: #f8fafc;
            --ps-gray: #64748b;
            --ps-success: #16a34a;
            --border-radius: 12px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background-color: #cbd5e1;
            color: var(--ps-dark);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .walkthrough-card {
            background: #ffffff;
            width: 850px;
            max-width: 100%;
            border-radius: var(--border-radius);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .header {
            background-color: var(--ps-blue);
            color: #ffffff;
            padding: 24px 32px;
            text-align: center;
        }

        .header h1 {
            font-size: 1.6rem;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .header p {
            font-size: 0.9rem;
            color: #93c5fd;
            margin-top: 4px;
        }

        .progress-container {
            width: 100%;
            background-color: #e2e8f0;
            height: 8px;
        }

        .progress-bar {
            height: 100%;
            background-color: var(--ps-orange);
            width: 20%;
            transition: width 0.4s ease-in-out;
        }

        .slide-body {
            padding: 32px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 480px;
        }

        .visual-container {
            width: 100%;
            max-width: 650px;
            height: 230px;
            background-color: var(--ps-light);
            border: 1px solid #e2e8f0;
            border-radius: var(--border-radius);
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 24px;
            padding: 12px;
        }

        .visual-container svg {
            width: 100%;
            height: 100%;
        }

        .slide-title {
            font-size: 1.35rem;
            color: var(--ps-blue);
            font-weight: 700;
            margin-bottom: 12px;
            text-align: center;
        }

        .slide-text {
            font-size: 1rem;
            line-height: 1.6;
            color: var(--ps-dark);
            text-align: center;
            max-width: 700px;
        }

        .navigation {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 32px;
            background-color: #f1f5f9;
            border-top: 1px solid #e2e8f0;
        }

        .step-indicator {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--ps-gray);
        }

        .btn-group {
            display: flex;
            gap: 12px;
        }

        button {
            padding: 10px 24px;
            font-size: 0.95rem;
            font-weight: 600;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-prev {
            background-color: #94a3b8;
            color: #ffffff;
        }

        .btn-prev:hover:not(:disabled) {
            background-color: #64748b;
        }

        .btn-next {
            background-color: var(--ps-orange);
            color: #ffffff;
        }

        .btn-next:hover:not(:disabled) {
            background-color: #d95e20;
        }

        button:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }
    </style>
</head>
<body>

    <div class="walkthrough-card">
        <div class="header">
            <h1>GLAB/IPLAB 634.3.1: Precision Fastener Torquing & Tool Safety Audit</h1>
            <p>High-Level Technical Walkthrough Presentation</p>
        </div>
        
        <div class="progress-container">
            <div class="progress-bar" id="progress-bar"></div>
        </div>

        <div class="slide-body">
            <div class="visual-container" id="visual-container"></div>
            <div class="slide-title" id="slide-title">Phase Title</div>
            <div class="slide-text" id="slide-text">Phase description goes here.</div>
        </div>

        <div class="navigation">
            <div class="step-indicator" id="step-indicator">Phase 1 of 5</div>
            <div class="btn-group">
                <button class="btn-prev" id="btn-prev" onclick="changeSlide(-1)">Previous</button>
                <button class="btn-next" id="btn-next" onclick="changeSlide(1)">Next</button>
            </div>
        </div>
    </div>

    <script>
        const walkthroughData = [
            {
                title: "Phase 1: Pre-Lab VR Onboarding & Tool Safety Inspection",
                text: "Transition to Zone 2 VR Grid to complete the Interplay Hand and Power Tool Safety simulation. Afterward, conduct a physical pre-use inspection of 1000V insulated screwdrivers, torque wrenches, pneumatic whip checks, and angle grinder safety guards across physical shop floor stations.",
                svg: `<svg viewBox="0 0 600 200" xmlns="http://www.w3.org/2000/svg">
                    <rect width="600" height="200" fill="#f8fafc" rx="8"/>
                    <rect x="30" y="30" width="240" height="140" rx="10" fill="#004b87" opacity="0.08" stroke="#004b87" stroke-width="2" stroke-dasharray="6 4"/>
                    <text x="150" y="55" font-family="sans-serif" font-size="13" font-weight="bold" fill="#004b87" text-anchor="middle">Zone 2: VR Simulation Grid</text>
                    <path d="M 85 95 C 85 80, 215 80, 215 95 C 215 130, 185 130, 150 130 C 115 130, 85 130, 85 95 Z" fill="#004b87"/>
                    <circle cx="120" cy="105" r="16" fill="#ffffff" opacity="0.9"/>
                    <circle cx="180" cy="105" r="16" fill="#ffffff" opacity="0.9"/>
                    <rect x="95" y="85" width="110" height="8" rx="4" fill="#f26f29"/>
                    <text x="150" y="155" font-family="sans-serif" font-size="11" fill="#333333" text-anchor="middle">Interplay VR Tool Safety</text>
                    <path d="M 290 100 L 330 100" stroke="#f26f29" stroke-width="4"/>
                    <rect x="350" y="30" width="220" height="140" rx="10" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
                    <text x="460" y="55" font-family="sans-serif" font-size="13" font-weight="bold" fill="#004b87" text-anchor="middle">Tool Defect Audit</text>
                    <circle cx="375" cy="85" r="7" fill="#16a34a"/>
                    <text x="392" y="89" font-family="sans-serif" font-size="11" fill="#333333">1000V Insulated Layer Check</text>
                    <circle cx="375" cy="115" r="7" fill="#16a34a"/>
                    <text x="392" y="119" font-family="sans-serif" font-size="11" fill="#333333">Pneumatic Whip Check Cable</text>
                    <circle cx="375" cy="145" r="7" fill="#16a34a"/>
                    <text x="392" y="149" font-family="sans-serif" font-size="11" fill="#333333">Angle Grinder 180° Guard</text>
                </svg>`
            },
            {
                title: "Phase 2: Precision Torque Calculations",
                text: "At Zone 1 Learner Desks, apply the single-variable formula Torque = Force x Distance to calculate exact perpendicular force requirements for motor mounting bolts (45 ft-lbs spec) and determine micrometer scale settings for control cabinet terminal screws (18 in-lbs spec).",
                svg: `<svg viewBox="0 0 600 200" xmlns="http://www.w3.org/2000/svg">
                    <rect width="600" height="200" fill="#f8fafc" rx="8"/>
                    <text x="300" y="32" font-family="sans-serif" font-size="15" font-weight="bold" fill="#004b87" text-anchor="middle">Torque = Force × Distance</text>
                    <rect x="50" y="60" width="500" height="110" rx="8" fill="#ffffff" stroke="#004b87" stroke-width="2"/>
                    <rect x="80" y="105" width="260" height="16" rx="4" fill="#64748b"/>
                    <rect x="320" y="95" width="70" height="36" rx="4" fill="#f26f29"/>
                    <circle cx="95" cy="113" r="14" fill="#1e293b" stroke="#ffffff" stroke-width="2"/>
                    <path d="M 355 70 L 355 90" stroke="#dc2626" stroke-width="3" stroke-dasharray="4 2"/>
                    <polygon points="355,95 350,85 360,85" fill="#dc2626"/>
                    <text x="355" y="62" font-family="sans-serif" font-size="11" font-weight="bold" fill="#dc2626" text-anchor="middle">Applied Force (F)</text>
                    <line x1="95" y1="135" x2="355" y2="135" stroke="#004b87" stroke-width="2"/>
                    <text x="225" y="152" font-family="sans-serif" font-size="11" font-weight="bold" fill="#004b87" text-anchor="middle">Lever Arm Distance (d = 1.5 ft)</text>
                    <text x="455" y="95" font-family="sans-serif" font-size="11" font-weight="bold" fill="#1e293b" text-anchor="middle">Target Specs:</text>
                    <text x="455" y="115" font-family="sans-serif" font-size="10" fill="#16a34a" text-anchor="middle">Motor Mount: 45 ft-lbs</text>
                    <text x="455" y="132" font-family="sans-serif" font-size="10" fill="#16a34a" text-anchor="middle">Terminals: 18 in-lbs</text>
                </svg>`
            },
            {
                title: "Phase 3: Precision Torque Overhaul Speed Run",
                text: "Transition to Zone 3 Perimeter Hardware Stations for a timed 20-minute speed run. Adjust 1/2-inch drive click torque wrenches and torque screwdrivers to target specs, apply smooth uniform force until the tool clicks, and obtain peer verification sign-offs.",
                svg: `<svg viewBox="0 0 600 200" xmlns="http://www.w3.org/2000/svg">
                    <rect width="600" height="200" fill="#f8fafc" rx="8"/>
                    <circle cx="300" cy="100" r="45" fill="#ffffff" stroke="#dc2626" stroke-width="4"/>
                    <text x="300" y="95" font-family="sans-serif" font-size="14" font-weight="bold" fill="#dc2626" text-anchor="middle">20 MIN</text>
                    <text x="300" y="112" font-family="sans-serif" font-size="9" font-weight="bold" fill="#333333" text-anchor="middle">SPEED RUN</text>
                    <rect x="40" y="45" width="160" height="110" rx="8" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
                    <rect x="40" y="45" width="160" height="26" rx="8" fill="#004b87"/>
                    <text x="120" y="62" font-family="sans-serif" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle">Motor Mount Bolts</text>
                    <text x="120" y="92" font-family="sans-serif" font-size="10" font-weight="bold" fill="#1e293b" text-anchor="middle">3/8-16 Grade 8</text>
                    <text x="120" y="112" font-family="sans-serif" font-size="11" font-weight="bold" fill="#16a34a" text-anchor="middle">45.0 ft-lbs (+/- 4%)</text>
                    <text x="120" y="132" font-family="sans-serif" font-size="9" fill="#64748b" text-anchor="middle">1/2" Click Torque Wrench</text>
                    <rect x="400" y="45" width="160" height="110" rx="8" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
                    <rect x="400" y="45" width="160" height="26" rx="8" fill="#004b87"/>
                    <text x="480" y="62" font-family="sans-serif" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle">Control Terminals</text>
                    <text x="480" y="92" font-family="sans-serif" font-size="10" font-weight="bold" fill="#1e293b" text-anchor="middle">M3 & M4 Screws</text>
                    <text x="480" y="112" font-family="sans-serif" font-size="11" font-weight="bold" fill="#16a34a" text-anchor="middle">18.0 & 25.0 in-lbs</text>
                    <text x="480" y="132" font-family="sans-serif" font-size="9" fill="#64748b" text-anchor="middle">Torque Screwdriver</text>
                </svg>`
            },
            {
                title: "Phase 4: AI Tool Log Verification & Shift Audit",
                text: "Audit an AI-generated tool report for Work Order WO-2026-TOOL-03. Identify 3 critical violations: relying on hand feel instead of calibrated wrenches, reusing damaged 1000V tools, and storing torque wrenches under high tension. Draft a corrected GDP-compliant log entry.",
                svg: `<svg viewBox="0 0 600 200" xmlns="http://www.w3.org/2000/svg">
                    <rect width="600" height="200" fill="#f8fafc" rx="8"/>
                    <rect x="30" y="35" width="240" height="130" rx="8" fill="#ffffff" stroke="#dc2626" stroke-width="2"/>
                    <rect x="30" y="35" width="240" height="28" rx="8" fill="#dc2626"/>
                    <text x="150" y="53" font-family="sans-serif" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle">Unverified AI Log (Violations Found)</text>
                    <text x="150" y="82" font-family="sans-serif" font-size="9" fill="#dc2626" text-anchor="middle">Recommended torquing by hand feel</text>
                    <text x="150" y="102" font-family="sans-serif" font-size="9" fill="#dc2626" text-anchor="middle">Approved torn 1000V screwdriver reuse</text>
                    <text x="150" y="122" font-family="sans-serif" font-size="9" fill="#dc2626" text-anchor="middle">Stored torque wrench at 80 ft-lbs tension</text>
                    <text x="150" y="145" font-family="sans-serif" font-size="10" font-weight="bold" fill="#dc2626" text-anchor="middle">REJECTED BY TECHNICIAN</text>
                    <path d="M 280 100 L 320 100" stroke="#f26f29" stroke-width="4"/>
                    <rect x="330" y="35" width="240" height="130" rx="8" fill="#ffffff" stroke="#16a34a" stroke-width="2"/>
                    <rect x="330" y="35" width="240" height="28" rx="8" fill="#16a34a"/>
                    <text x="450" y="53" font-family="sans-serif" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle">Human Verified Technician Log</text>
                    <text x="450" y="82" font-family="sans-serif" font-size="9" fill="#1e293b" text-anchor="middle">Torqued motor mounts to 45.0 ft-lbs spec</text>
                    <text x="450" y="102" font-family="sans-serif" font-size="9" fill="#1e293b" text-anchor="middle">Tagged & replaced defective 1000V tool</text>
                    <text x="450" y="122" font-family="sans-serif" font-size="9" fill="#16a34a" text-anchor="middle">Dialed torque wrench to lowest setting</text>
                    <text x="450" y="148" font-family="sans-serif" font-size="10" font-weight="bold" fill="#16a34a" text-anchor="middle">APPROVED FOR SHIFT RELEASE</text>
                </svg>`
            },
            {
                title: "Phase 5: Technical Reflection & Tool Storage Protocol",
                text: "Complete technical reflection questions on spring calibration decay, dual-color dielectric insulation, and pneumatic whip check safety. Dial all click torque wrenches back to their lowest scale setting, depressurize air lines, and submit completed GDP worksheets to Canvas LMS.",
                svg: `<svg viewBox="0 0 600 200" xmlns="http://www.w3.org/2000/svg">
                    <rect width="600" height="200" fill="#f8fafc" rx="8"/>
                    <rect x="40" y="45" width="150" height="110" rx="8" fill="#ffffff" stroke="#004b87" stroke-width="2"/>
                    <text x="115" y="70" font-family="sans-serif" font-size="12" font-weight="bold" fill="#004b87" text-anchor="middle">Wrench Storage</text>
                    <text x="115" y="100" font-family="sans-serif" font-size="14" font-weight="bold" fill="#16a34a" text-anchor="middle">Zero Tension</text>
                    <text x="115" y="125" font-family="sans-serif" font-size="10" fill="#64748b" text-anchor="middle">Dialed to Lowest Setting</text>
                    <rect x="225" y="45" width="150" height="110" rx="8" fill="#ffffff" stroke="#004b87" stroke-width="2"/>
                    <text x="300" y="70" font-family="sans-serif" font-size="12" font-weight="bold" fill="#004b87" text-anchor="middle">Pneumatic Reset</text>
                    <text x="300" y="100" font-family="sans-serif" font-size="11" fill="#333333" text-anchor="middle">Lines Depressurized</text>
                    <text x="300" y="125" font-family="sans-serif" font-size="10" fill="#64748b" text-anchor="middle">Whip Checks Unclipped</text>
                    <rect x="410" y="45" width="150" height="110" rx="8" fill="#ffffff" stroke="#16a34a" stroke-width="2"/>
                    <text x="485" y="70" font-family="sans-serif" font-size="12" font-weight="bold" fill="#16a34a" text-anchor="middle">Canvas Submission</text>
                    <path d="M 440 95 L 460 115 L 520 80" stroke="#16a34a" stroke-width="4" fill="none"/>
                    <text x="485" y="135" font-family="sans-serif" font-size="10" font-weight="bold" fill="#004b87" text-anchor="middle">Worksheet Submitted</text>
                </svg>`
            }
        ];

        let currentSlide = 0;

        function updateUI() {
            const slide = walkthroughData[currentSlide];
            
            document.getElementById('slide-title').innerText = slide.title;
            document.getElementById('slide-text').innerText = slide.text;
            document.getElementById('visual-container').innerHTML = slide.svg;
            document.getElementById('step-indicator').innerText = `Phase ${currentSlide + 1} of ${walkthroughData.length}`;

            const progressPercentage = ((currentSlide + 1) / walkthroughData.length) * 100;
            document.getElementById('progress-bar').style.width = progressPercentage + '%';

            document.getElementById('btn-prev').disabled = currentSlide === 0;
            
            const btnNext = document.getElementById('btn-next');
            if (currentSlide === walkthroughData.length - 1) {
                btnNext.innerText = "Finish";
            } else {
                btnNext.innerText = "Next";
            }
        }

        function changeSlide(direction) {
            currentSlide += direction;
            if (currentSlide < 0) currentSlide = 0;
            if (currentSlide >= walkthroughData.length) currentSlide = walkthroughData.length - 1;
            updateUI();
        }

        updateUI();
    </script>
</body>
</html>